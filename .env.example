APP_ENV=development
APP_NAME=Airdrop Engine
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Required for Telegram Mini App initData verification in non-test environments.
# Never commit real values.
TELEGRAM_BOT_TOKEN=

# Set a strong random value outside source control before issuing app sessions.
SESSION_SECRET=replace-with-a-long-random-secret

DATABASE_URL=postgresql+psycopg://airdrop:airdrop@localhost:5432/airdrop_engine
REDIS_URL=redis://localhost:6379/0

TELEGRAM_INITDATA_MAX_AGE_SECONDS=300
